{
  "components": {
    "schemas": {
      "ErrorEnum": {
        "description": "* `email_send_failed` - email_send_failed",
        "enum": ["email_send_failed"],
        "type": "string"
      },
      "LocaleEnum": {
        "description": "* `en` - en\n* `es` - es",
        "enum": ["en", "es"],
        "type": "string"
      },
      "PartnerOrgPublic": {
        "properties": {
          "name": {
            "description": "The name of the partner organization.",
            "maxLength": 150,
            "type": "string"
          },
          "slug": {
            "description": "The short identifier for the partner organization.",
            "maxLength": 20,
            "pattern": "^[-a-zA-Z0-9_]+$",
            "type": "string"
          },
          "website": {
            "description": "The primary website of the partner organization.",
            "format": "uri",
            "maxLength": 200,
            "type": "string"
          }
        },
        "required": ["name", "slug", "website"],
        "type": "object"
      },
      "RhRequestServiceError": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorEnum"
          }
        },
        "required": ["error"],
        "type": "object"
      },
      "SendRhRequestRequest": {
        "properties": {
          "address": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "address_verified": {
            "type": "boolean"
          },
          "apartment_number": {
            "maxLength": 15,
            "minLength": 1,
            "type": "string"
          },
          "bbl": {
            "maxLength": 10,
            "minLength": 1,
            "type": "string"
          },
          "borough": {
            "description": "Borough name. Accepts legacy enum values (MANHATTAN, BROOKLYN, QUEENS, BRONX, STATEN_ISLAND) or GeoSearch title-case (Manhattan, Brooklyn, Queens, Bronx, Staten Island).",
            "maxLength": 20,
            "minLength": 1,
            "type": "string"
          },
          "first_name": {
            "maxLength": 30,
            "minLength": 1,
            "type": "string"
          },
          "last_name": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string"
          },
          "locale": {
            "$ref": "#/components/schemas/LocaleEnum"
          },
          "phone_number": {
            "maxLength": 32,
            "minLength": 1,
            "type": "string"
          },
          "referral_slug": {
            "maxLength": 20,
            "type": "string"
          },
          "source": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SourceEnum"
              }
            ],
            "default": "online"
          },
          "zipcode": {
            "maxLength": 5,
            "type": "string"
          }
        },
        "required": [
          "address",
          "apartment_number",
          "bbl",
          "borough",
          "first_name",
          "last_name",
          "locale",
          "phone_number"
        ],
        "type": "object"
      },
      "SendRhRequestResponse": {
        "properties": {
          "email_sent": {
            "type": "boolean"
          },
          "latest_year": {
            "nullable": true,
            "type": "integer"
          },
          "stabilized_units": {
            "nullable": true,
            "type": "integer"
          }
        },
        "required": ["email_sent", "latest_year", "stabilized_units"],
        "type": "object"
      },
      "SourceEnum": {
        "description": "* `online` - Online\n* `sms` - SMS",
        "enum": ["online", "sms"],
        "type": "string"
      }
    },
    "securitySchemes": {
      "rhRequestBearerAuth": {
        "description": "Static service bearer token (RH_REQUEST_API_TOKEN). Required for POST /rh-request/send-request.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "OpenAPI 3 schema for DHCR rent history request (`/rh-request/*`).",
    "title": "JustFix RH Request API",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/rh-request/partners/{slug}/": {
      "get": {
        "operationId": "partners_retrieve",
        "parameters": [
          {
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerOrgPublic"
                }
              }
            },
            "description": ""
          },
          "404": {
            "description": "Unknown slug"
          }
        },
        "tags": ["rh-request"]
      }
    },
    "/rh-request/send-request": {
      "post": {
        "operationId": "send_request_create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendRhRequestRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendRhRequestResponse"
                }
              }
            },
            "description": ""
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Missing or invalid bearer token"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RhRequestServiceError"
                }
              }
            },
            "description": "DHCR email send failed; no row persisted"
          }
        },
        "security": [
          {
            "rhRequestBearerAuth": []
          }
        ],
        "tags": ["rh-request"]
      }
    }
  }
}
